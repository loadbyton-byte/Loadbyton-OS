# Copy to .env.production (0600). Supply keys at deployment; none are committed.
NODE_ENV=production
PUBLIC_BASE_URL=https://app.loadbyton.store
ROOT_DOMAIN=loadbyton.store
# Neon TLS-verified pooled endpoint; use a DIRECT endpoint for migration/backup.
DATABASE_URL=
MIGRATION_DATABASE_URL=
MIGRATE_ON_START=false
SESSION_SECRET=
MFA_ENCRYPTION_KEY=
MFA_ENCRYPTION_PREVIOUS_KEY=
METRICS_TOKEN=
REQUIRE_COMPANY_MFA=true
# Contracting service provider shown at checkout and on receipts: the one UAE legal entity that also operates loadbyton.com.
# SELLER_TRN is the UAE Tax Registration Number; leave it empty until the entity is VAT-registered (receipts then read "Payment receipt", not "Tax invoice").
SELLER_LEGAL_NAME=
SELLER_TRADE_NAME=
SELLER_TRN=
SELLER_TRADE_LICENCE=
SELLER_LICENCE_AUTHORITY=
SELLER_ADDRESS=
SELLER_SUPPORT_EMAIL=
CHECKOUT_VAT_BPS=
CHECKOUT_TAX_NOTE=
LEGAL_REVIEWED=false
# Operator declaration (18 Oct 2026): all 18 sector packs are live. Independent acceptance is still recorded in the readiness register.
SECTOR_RELEASE=all
BROCHURE_MODE=false
DATA_RETENTION_DAYS=
DEPLOYMENT_REGION=
# Stripe on the UAE entity's own account (AED, cards, Apple Pay, Google Pay). Razorpay needs an Indian business account and is not used by a UAE entity.
PAYMENT_PROVIDER=stripe
PAYMENT_PROVIDERS=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Private S3-compatible bucket (Oracle Object Storage, Cloudflare R2, MinIO, AWS S3).
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PATH_STYLE=true
# Verified TLS to the database (certificate checked); DATABASE_SSL=no-verify is refused in production.
DATABASE_SSL=require
CLAMAV_HOST=scanner
CLAMAV_PORT=3310
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ORIGIN_HOSTNAME=
CLOUDFLARE_TUNNEL_TOKEN=
# Transactional email through Resend, from a domain verified there.
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM=
# Use the reviewed application image digest for release/rollback.
APP_IMAGE=loadbyton:local

# Optional reviewed INR quote for an Indian Razorpay merchant. AED default requires merchant eligibility.
RAZORPAY_PRESENTMENT_CURRENCY=AED
RAZORPAY_AED_TO_INR=
RAZORPAY_FX_NOTE=
SCANNER_IMAGE=loadbyton-scanner:local
BACKUP_ENCRYPTION_KEY=
BACKUP_OUTPUT_DIR=/secure-backups

# Optional assistant. Default deterministic drafts make no external model calls.
AI_PROVIDER=none
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_DATA_PROCESSING_REVIEWED=false
# Set reviewed vendor prices in micro-USD per token (not per million tokens).
AI_INPUT_MICRO_USD_PER_TOKEN=
AI_OUTPUT_MICRO_USD_PER_TOKEN=
AI_PRICING_NOTE=
# Per-company monthly conservative ceiling in micro-USD. Zero disables paid generation.
AI_MONTHLY_BUDGET_MICRO_USD=0
