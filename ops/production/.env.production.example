# Copy to .env.production (0600). Supply keys at deployment; none are committed.
NODE_ENV=production
PUBLIC_BASE_URL=https://app.loadbyton.store
ROOT_DOMAIN=loadbyton.store
# Neon TLS-verified pooled endpoint; use a DIRECT endpoint for migration/backup.
DATABASE_URL=
MIGRATION_DATABASE_URL=
MIGRATE_ON_START=false
SESSION_SECRET=
MFA_ENCRYPTION_KEY=
MFA_ENCRYPTION_PREVIOUS_KEY=
METRICS_TOKEN=
REQUIRE_COMPANY_MFA=true
# Indian contracting service provider. GST ID does not imply UAE VAT registration.
MERCHANT_LEGAL_NAME=
MERCHANT_COUNTRY=IN
MERCHANT_ADDRESS=
MERCHANT_TAX_ID=
SUPPORT_EMAIL=
CHECKOUT_VAT_BPS=
CHECKOUT_TAX_LABEL=
CHECKOUT_TAX_NOTE=
LEGAL_REVIEWED=false
DATA_RETENTION_DAYS=
DEPLOYMENT_REGION=
# Enable both only when each merchant account supports the catalogue currency AED.
PAYMENT_PROVIDER=stripe
PAYMENT_PROVIDERS=stripe,razorpay
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STORAGE_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents
CLAMAV_HOST=scanner
CLAMAV_PORT=3310
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ORIGIN_HOSTNAME=
CLOUDFLARE_TUNNEL_TOKEN=
# SMTP credentials URL encoded; smtp requires STARTTLS, smtps uses TLS directly.
SMTP_URL=
EMAIL_FROM=
# Use the reviewed application image digest for release/rollback.
APP_IMAGE=loadbyton:local

# Optional reviewed INR quote for an Indian Razorpay merchant. AED default requires merchant eligibility.
RAZORPAY_PRESENTMENT_CURRENCY=AED
RAZORPAY_AED_TO_INR=
RAZORPAY_FX_NOTE=
SCANNER_IMAGE=loadbyton-scanner:local
BACKUP_ENCRYPTION_KEY=
BACKUP_OUTPUT_DIR=/secure-backups

# Optional assistant. Default deterministic drafts make no external model calls.
AI_PROVIDER=none
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_DATA_PROCESSING_REVIEWED=false
# Set reviewed vendor prices in micro-USD per token (not per million tokens).
AI_INPUT_MICRO_USD_PER_TOKEN=
AI_OUTPUT_MICRO_USD_PER_TOKEN=
AI_PRICING_NOTE=
# Per-company monthly conservative ceiling in micro-USD. Zero disables paid generation.
AI_MONTHLY_BUDGET_MICRO_USD=0
