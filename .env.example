# Runtime
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
# Root domain used for host-based tenant context (company.loadbyton.store). Empty = path-based only.
ROOT_DOMAIN=
# Database. Empty = embedded Postgres (PGlite) stored in ./data/pg  (dev/test only).
DATABASE_URL=
# Secrets (REQUIRED in production, min 32 chars)
SESSION_SECRET=change-me-change-me-change-me-change-me
PAYMENT_WEBHOOK_SECRET=change-me-change-me-change-me-change-me
# Payment provider: "mock" (non-production only) or a configured adapter name
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDERS=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Tax shown at checkout (basis points). UAE standard VAT = 500. Confirm treatment with an accountant.
CHECKOUT_VAT_BPS=500
CHECKOUT_TAX_LABEL=Tax
CHECKOUT_TAX_NOTE=Development tax illustration only; set the approved merchant treatment before deployment.
MERCHANT_LEGAL_NAME=
MERCHANT_COUNTRY=IN
MERCHANT_ADDRESS=
MERCHANT_TAX_ID=
SUPPORT_EMAIL=
MFA_ENCRYPTION_KEY=dev-only-change-at-deployment-32-characters
# Temporary during the rehearsed dual-key rotation window; omit otherwise.
MFA_ENCRYPTION_PREVIOUS_KEY=
REQUIRE_COMPANY_MFA=false
# Private object storage root (tenant-scoped paths)
STORAGE_DIR=./data/files
STORAGE_PROVIDER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents
CLAMAV_HOST=
CLAMAV_PORT=3310
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ORIGIN_HOSTNAME=
SMTP_URL=
EMAIL_FROM=
LEGAL_REVIEWED=false
DATA_RETENTION_DAYS=90
DEPLOYMENT_REGION=Development environment
MIGRATE_ON_START=true
MIGRATION_DATABASE_URL=
BACKUP_ENCRYPTION_KEY=
BACKUP_OUTPUT_DIR=./backups
# Run in-process background workers (provisioning, outbox). Use separate worker process in production.
RUN_WORKERS=true

# Optional internal Prometheus scrape token (32+ chars); leave empty to disable /metrics.
METRICS_TOKEN=

# Optional reviewed INR quote for an Indian Razorpay merchant. AED default requires merchant eligibility.
RAZORPAY_PRESENTMENT_CURRENCY=AED
RAZORPAY_AED_TO_INR=
RAZORPAY_FX_NOTE=

# Optional assistant. Default deterministic drafts make no external model calls.
AI_PROVIDER=none
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_DATA_PROCESSING_REVIEWED=false
# Set reviewed vendor prices in micro-USD per token (not per million tokens).
AI_INPUT_MICRO_USD_PER_TOKEN=
AI_OUTPUT_MICRO_USD_PER_TOKEN=
AI_PRICING_NOTE=
# Per-company monthly conservative ceiling in micro-USD. Zero disables paid generation.
AI_MONTHLY_BUDGET_MICRO_USD=0
