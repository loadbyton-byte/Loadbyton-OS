# ───────────────────────── Runtime
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
# Root domain for host-based tenant context (company.example.com). Empty = path-based only.
ROOT_DOMAIN=
# Run in-process background workers (provisioning, outbox). Keep true while you run a single web instance.
RUN_WORKERS=true
# Uploaded documents. fs = local disk under STORAGE_DIR (mount a persistent volume). s3 = any S3-compatible store: Oracle Object Storage
# (S3 compatibility endpoint: https://NAMESPACE.compat.objectstorage.REGION.oraclecloud.com, path-style), Cloudflare R2
# (https://ACCOUNT.r2.cloudflarestorage.com, region auto), MinIO, AWS S3. Create the bucket PRIVATE; create an access key limited to that bucket.
STORAGE_DRIVER=fs
STORAGE_DIR=./data/files
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for Oracle/R2/MinIO (bucket in the path); false for AWS virtual-hosted style
S3_PATH_STYLE=true

# ───────────────────────── Database
# Empty = embedded Postgres (PGlite) in ./data/pg — development/test only.
# Neon:     postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require      (pooled endpoint is fine for the app)
# Supabase: postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres    (transaction pooler is fine for the app)
DATABASE_URL=
# Direct (non-pooled) connection used ONLY for migrations at start-up. Neon: the endpoint without "-pooler". Supabase: db.PROJECT.supabase.co:5432.
MIGRATION_DATABASE_URL=
# "" (driver default) | require (TLS with certificate verification — use this for Neon/Supabase) | no-verify (dev only; refused in production) | disable
DATABASE_SSL=
# Optional PEM of a private CA (use \n for newlines) when your provider is not signed by a public CA.
DATABASE_CA=
DATABASE_POOL_MAX=10

# ───────────────────────── Secrets (REQUIRED in production, min 32 chars: openssl rand -hex 32)
SESSION_SECRET=change-me-change-me-change-me-change-me
# Only used by the simulated "mock" provider (development/test). Real providers use their own signing secrets below.
PAYMENT_WEBHOOK_SECRET=change-me-change-me-change-me-change-me

# ───────────────────────── Payments
# Comma list of enabled providers; the first is the default at checkout. mock | stripe | razorpay.  "mock" is refused in production.
PAYMENT_PROVIDERS=mock
# Stripe — Checkout (cards, Google Pay, Apple Pay, Link as enabled in your Stripe dashboard → Settings → Payment methods)
#   Webhook endpoint:  https://YOUR-DOMAIN/webhooks/payments/stripe
#   Events to send:    checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
#                      checkout.session.expired, charge.refunded
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: restrict methods, e.g. "card". Empty = Stripe's dynamic payment methods.
STRIPE_PAYMENT_METHODS=
# Razorpay — hosted Payment Links (UPI incl. Google Pay, cards, netbanking). AED needs Razorpay "International Payments" enabled on your account.
#   Webhook URL:       https://YOUR-DOMAIN/webhooks/payments/razorpay   (set the same secret here)
#   Events to send:    payment_link.paid, payment_link.cancelled, payment_link.expired, refund.processed
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Smoke test ONLY: allow sk_test_/rzp_test_ keys while NODE_ENV=production. Remove before taking real payments.
ALLOW_TEST_PAYMENT_KEYS=

# ───────────────────────── Tax and seller identity (shown at checkout, on receipts and in the site footer)
# Tax shown at checkout, in basis points (500 = 5%). Set 0 if you charge no UAE VAT. Your accountant decides the treatment for your supplies.
CHECKOUT_VAT_BPS=500
# Overrides the default tax sentence at checkout and on receipts, e.g. an export-of-services / reverse-charge statement.
CHECKOUT_TAX_NOTE=
SELLER_LEGAL_NAME=
SELLER_TRADE_NAME=
SELLER_ADDRESS=
SELLER_GSTIN=
SELLER_PAN=
SELLER_SUPPORT_EMAIL=
# Optional lines printed on receipts: service accounting code, place-of-supply statement, LUT / export declaration reference.
SELLER_SAC=
SELLER_SUPPLY_NOTE=
SELLER_LUT_NOTE=

# ───────────────────────── Email and SMS
# log (default: prints one line, no body; invitations also stay visible as links in the UI) | resend | smtp
MAIL_PROVIDER=log          # log | resend | smtp (smtp works with Amazon SES: email-smtp.<region>.amazonaws.com:587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
RESEND_API_KEY=
# A sender on a domain you verified in Resend, e.g. LOAD|BY|TON <noreply@yourdomain.com>
MAIL_FROM=
# SMS to consignees (opt-in per merchant under Delivery → Integrations): log | twilio
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 number or an alphanumeric sender ID approved for the UAE
TWILIO_FROM=

# ───────────────────────── Monitoring
# Bearer token for GET /metrics (Prometheus text, aggregate counts only). Unset = endpoint disabled. openssl rand -hex 24
METRICS_TOKEN=

# ───────────────────────── Edge, rate limiting
# Which header carries the real client IP: cloudflare (CF-Connecting-IP) | xff (first X-Forwarded-For hop) | empty = trust nothing.
# Set cloudflare ONLY when every request really arrives through Cloudflare (tunnel or locked-down origin).
TRUST_PROXY=
# Upstash Redis (REST) shares sign-in / tracking rate limits across instances. Both or neither. Without it, limits are per process.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry error reporting (web + worker). Empty DSN = off. No cookies, request bodies, query strings or user data are sent.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# Cloudflare Tunnel token (only read by docker-compose.prod.yml for the cloudflared container)
CLOUDFLARE_TUNNEL_TOKEN=

# ───────────────────────── Security, retention, backups and assistant
MFA_ENCRYPTION_KEY=dev-only-change-at-deployment-32-characters
# Temporary during the rehearsed dual-key rotation window; omit otherwise.
MFA_ENCRYPTION_PREVIOUS_KEY=
REQUIRE_COMPANY_MFA=false
CLAMAV_HOST=
CLAMAV_PORT=3310
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ORIGIN_HOSTNAME=
LEGAL_REVIEWED=false
DATA_RETENTION_DAYS=90
DEPLOYMENT_REGION=Development environment
MIGRATE_ON_START=true
BACKUP_ENCRYPTION_KEY=
BACKUP_OUTPUT_DIR=./backups
# Optional reviewed INR quote for an Indian Razorpay merchant. AED default requires merchant eligibility.
RAZORPAY_PRESENTMENT_CURRENCY=AED
RAZORPAY_AED_TO_INR=
RAZORPAY_FX_NOTE=
# Optional assistant. Default deterministic drafts make no external model calls.
AI_PROVIDER=none
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_DATA_PROCESSING_REVIEWED=false
# Set reviewed vendor prices in micro-USD per token (not per million tokens).
AI_INPUT_MICRO_USD_PER_TOKEN=
AI_OUTPUT_MICRO_USD_PER_TOKEN=
AI_PRICING_NOTE=
# Per-company monthly conservative ceiling in micro-USD. Zero disables paid generation.
AI_MONTHLY_BUDGET_MICRO_USD=0

# ───────────────────────── UAE e-invoicing provider (accredited service provider)
# Leave blank until the customer is accredited with a provider. The paths and vocabulary below are the provider's own; the provider's answer is authoritative.
EINVOICE_ASP_NAME=
EINVOICE_ASP_BASE_URL=
EINVOICE_ASP_API_KEY=
# bearer = Authorization: Bearer <key>; header = the key goes in EINVOICE_ASP_AUTH_HEADER
EINVOICE_ASP_AUTH=bearer
EINVOICE_ASP_AUTH_HEADER=x-api-key
EINVOICE_ASP_TENANT_ID=
EINVOICE_ASP_TENANT_HEADER=x-tenant-id
# json = {reference, kind, document(base64 UBL)}; xml = the raw UBL as the request body
EINVOICE_ASP_BODY=json
EINVOICE_ASP_SUBMIT_PATH=/documents
EINVOICE_ASP_STATUS_PATH=/documents/{ref}
EINVOICE_ASP_REFERENCE_FIELD=id
EINVOICE_ASP_STATUS_FIELD=status
EINVOICE_ASP_REASONS_FIELD=errors
EINVOICE_ASP_ACCEPTED_VALUES=accepted,delivered,cleared,approved
EINVOICE_ASP_REJECTED_VALUES=rejected,invalid,failed_validation
EINVOICE_ASP_ERROR_VALUES=error

# Per-client e-invoicing providers (the "E-invoicing" add-on): each client's provider API key and taxpayer ID are entered by platform staff at /admin/einvoice and
# stored encrypted. Only the provider's webhook signing secret lives here (Wafeq: Developer → Webhooks, whsec_…; comma-separate two while rotating).
# Point the provider's webhook at https://<your-host>/webhooks/einvoice/wafeq
EINVOICE_WAFEQ_WEBHOOK_SECRET=

# ───────────────────────── WhatsApp delivery notices (Meta Cloud API)
WHATSAPP_PROVIDER=log
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=en
# Names of templates Meta has approved. Variables, in order — out for delivery: {{1}} company {{2}} waybill {{3}} merchant {{4}} cash due {{5}} delivery code {{6}} tracking link;
# attempt failed: {{1}} company {{2}} waybill {{3}} merchant {{4}} tracking link
WHATSAPP_TEMPLATE_OUT_FOR_DELIVERY=
WHATSAPP_TEMPLATE_ATTEMPT_FAILED=

# ───────────────────────── Live statement feeds (bank / card / fuel / Salik)
# Hosts a workspace may point a feed at (comma list of public host names). Empty = feeds disabled. Each workspace supplies its own credential in the app.
FEED_ALLOWED_HOSTS=
FEED_PULL_INTERVAL_MINUTES=60

# ───────────────────────── OCR for scanned documents (Google Cloud Vision)
# Document content is sent to the provider: set the reviewed flag only after that processing has been reviewed.
OCR_PROVIDER=none
OCR_API_KEY=
OCR_MAX_PAGES=5
OCR_DATA_PROCESSING_REVIEWED=false

# ── public contact points, live chat hours and the standing offer (all optional; defaults shown)
CONTACT_PHONE=+919661053007
CONTACT_EMAIL_INFO=info@loadbyton.com
CONTACT_EMAIL_SUPPORT=support@loadbyton.com
CONTACT_EMAIL_CONTACT=contact@loadbyton.com
CHAT_TZ=Asia/Kolkata
CHAT_FROM_HOUR=9
CHAT_TO_HOUR=21
# Offer banner and popup. Leave empty for a standing monthly onboarding offer that ends on the last day of the current month; OFFER_ENDS_ON=off hides it.
OFFER_CODE=
OFFER_TITLE=
OFFER_DETAIL=
OFFER_ENDS_ON=

# Address geocoding for transport stops (optional). Any service that answers the Nominatim /search JSON shape. The public OpenStreetMap server forbids bulk use:
# run your own Nominatim or use a commercial gateway. Results are proposals the dispatcher sees; coordinates keep their "geocoded" label.
GEOCODER_URL=
GEOCODER_API_KEY=
GEOCODER_COUNTRY_CODES=ae
GEOCODER_USER_AGENT=

# Road-network routing for trip planning (optional): an OSRM-compatible service answering /table/v1/<profile>/<lon,lat;...>. Empty = straight-line planning.
# Durations are those of the service (free-flow unless it models live traffic); the planner says which basis it used.
ROUTING_URL=
ROUTING_API_KEY=
ROUTING_PROFILE=driving
ROUTING_MAX_POINTS=60

# OCR provider alternative: OCR_PROVIDER=self-hosted runs Tesseract in your own `ocr` container (docker compose --profile ocr); OCR_API_BASE=http://ocr:8080. No document content leaves the installation.

# Company verification at registration (default: required in production). A new workspace is read-only until the owner confirms email and mobile, uploads a trade licence and staff approve.
# KYC_REQUIRED=true
# KYC_ALLOW_FREE_MAIL=false          # allow gmail/outlook-style addresses (they are flagged, not blocked, when true)
# KYC_SIGNUPS_PER_IP_PER_DAY=3
# KYC_PHONE_COUNTRY=AE               # default country for numbers typed without a country code

# Live-traffic routing: ROUTING_PROVIDER=google uses the Google Routes API (computeRouteMatrix, TRAFFIC_AWARE). Needs ROUTING_API_KEY (Routes API enabled, key restricted to this server's address). Limited to 25 points per plan.
# ROUTING_PROVIDER=osrm
